# ===== Database =====
DATABASE_URL=mysql+pymysql://equip_app:yourpassword@localhost:3306/equipment_db

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== JWT =====
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost

# ===== Upload =====
UPLOAD_DIR=/app/uploads

# ===== WeCom group robot =====
# Full webhook URL copied from the robot details. Keep it secret.
WECOM_BOT_WEBHOOK=
# Comma-separated mobile numbers registered in WeCom, used to @ the admins.
WECOM_MENTIONED_MOBILES=
# Public address of this system, appended to notification messages.
SYSTEM_PUBLIC_URL=
