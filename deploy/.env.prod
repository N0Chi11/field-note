# ============================================================================
# 生产环境配置文件 — 部署到阿里云 ECS
# 使用前复制为 .env 并修改密码
# ============================================================================

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=equipment_db
MYSQL_USER=equip_app
MYSQL_PASSWORD=REPLACE_WITH_A_STRONG_APP_PASSWORD

# ===== 后端环境变量 =====
DATABASE_URL=mysql+pymysql://equip_app:REPLACE_WITH_A_STRONG_APP_PASSWORD@mysql:3306/equipment_db?charset=utf8mb4
REDIS_URL=redis://redis:6379/0

# JWT 密钥 — 生产环境务必更换为随机长字符串
# 可用命令生成: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Independent signer for the photo-review cookie; never reuse JWT_SECRET.
# Generate with: openssl rand -hex 32
PHOTO_REVIEW_SESSION_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# CORS — 填你的服务器 IP 或域名
CORS_ORIGINS=http://47.116.101.102,https://47.116.101.102

# 上传目录
UPLOAD_DIR=/app/uploads

# ===== 企业微信群机器人 =====
# 真实 Webhook 仅填写在服务器根目录 .env，不要提交到仓库。
WECOM_BOT_WEBHOOK=
# 4 位管理员在企业微信中绑定的手机号，英文逗号分隔。
WECOM_MENTIONED_MOBILES=
# 系统公网地址，例如 http://47.116.101.102
SYSTEM_PUBLIC_URL=

# ===== 时区 =====
TZ=Asia/Shanghai
