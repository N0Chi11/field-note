# ============================================================================
# 生产环境配置文件 — 部署到阿里云 ECS
# 使用前复制为 .env 并修改密码
# ============================================================================

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=ChangeMe_Root_2026!
MYSQL_DATABASE=equipment_db
MYSQL_USER=equip_app
MYSQL_PASSWORD=ChangeMe_App_2026!

# ===== 后端环境变量 =====
DATABASE_URL=mysql+pymysql://equip_app:ChangeMe_App_2026!@mysql:3306/equipment_db
REDIS_URL=redis://redis:6379/0

# JWT 密钥 — 生产环境务必更换为随机长字符串
# 可用命令生成: openssl rand -hex 32
JWT_SECRET=ChangeMe_JWT_Secret_Key_2026_Replace_With_Random_String
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — 填你的服务器 IP 或域名
CORS_ORIGINS=http://47.116.101.102,https://47.116.101.102

# 上传目录
UPLOAD_DIR=/app/uploads

# ===== 时区 =====
TZ=Asia/Shanghai
